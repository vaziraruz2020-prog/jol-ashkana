# Local default: embedded Postgres (PGlite). No Docker.
# Leave DATABASE_URL empty on your PC.
DATABASE_URL=
STORE=

# Optional: persist PGlite in a custom folder
# PGLITE_DIR=C:\Users\sanch\AppData\Local\jol-ashkana\pglite

# Docker Postgres (optional, local):
# DATABASE_URL=postgres://jol:jol@127.0.0.1:5432/jol_ashkana

# --- Vercel (required for login on the internet) ---
# Local files are NOT used on Vercel. Neon is a separate database.
# In Vercel: Storage → Create Database → Neon
# then Settings → Environment (Production + Preview):
#   DATABASE_URL  (or POSTGRES_URL from the Neon integration)
#   JWT_SECRET    (long random string, not change-me-in-production)
#   ADMIN_EMAIL / ADMIN_PASSWORD  (optional support login)
# Then Redeploy. Check https://YOUR-APP.vercel.app/api/health
# Expect: { "ok": true, "db": "postgres" }
# Then register a NEW account on the live site (PC accounts are not in Neon).

JWT_SECRET=change-me-in-production
ADMIN_EMAIL=support@jol-ashkana.local
ADMIN_PASSWORD=Support2025!
