# Local default: embedded Postgres (PGlite). No Docker.
DATABASE_URL=
STORE=

# Optional: persist PGlite in a custom folder
# PGLITE_DIR=C:\Users\sanch\AppData\Local\jol-ashkana\pglite

# Docker Postgres:
# DATABASE_URL=postgres://jol:jol@127.0.0.1:5432/jol_ashkana

# Production on Vercel (required). Without this, /api/health returns 503.
# In Vercel: Storage → Create Database → Neon
# or Settings → Environment → add:
#   DATABASE_URL  (or POSTGRES_URL from the Neon integration)
#   JWT_SECRET
# Then Redeploy.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_SECRET=change-me-in-production
ADMIN_EMAIL=support@jol-ashkana.local
ADMIN_PASSWORD=Support2025!
